{
  "openapi": "3.0.3",
  "info": {
    "title": "Online Store API",
    "description": "the sale of Foods",
    "version": "1.0.0"
  },
  "paths": {
    "/api/customer-info/getProducts": {
      "get": {
        "description": "display products after user is authenticated and verified",
        "operationId": "getProducts",
        "parameters": [
          {
            "name": "email", 
            "in": "query",
            "description": "Customer's email",
            "required": true,
            "schema": {
              "type": "string"
            }
          },

          {
            "name": "password",  
            "in": "query",
            "description": "Customer's password",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All products displayed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customer"
                }
              }
            }
          }
        }
      }
    },
    "/api/customer-info/authentication": {
      "get": {
        "description": "get customer details based on email and password",
        "operationId": "getCustomerInfo",
        "parameters": [
          {
            "name": "email", 
            "in": "query",
            "description": "Customer's email",
            "required": true,
            "schema": {
              "type": "string"
            }
          },

          {
            "name": "password",  
            "in": "query",
            "description": "Customer's password",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "customer's profile displayed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customer"
                }
              }
            }
          }
        }
      }
    },
    
    "/api/customer-info/addCustomer": {
      "post": {
        "description": "Add new customer",
        "operationId": "createCustomer",
        "parameters": [
          {
            "name": "first_name",
            "in": "query",
            "description": "Customer's first name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last_name",
            "in": "query",
            "description": "Customer's last name",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Customer's email",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "password",
            "in": "query",
            "description": "Customer's password",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "phone_number",
            "in": "query",
            "description": "Customer's phone number",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Customer's created sucessfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customer"
                }
              }
            }
          }
        }
      }
    },

    "/api/customer-info/getProfile": {
      "get":{
        "parameters":[
          {
            "name":"customer_id",
            "in":"query",
            "description": "customer's id",
            "required": true,
            "schema":{
              "type":"integer"
            }
          }
        ],
        "responses":{
          "200":{
            "description": "customer's profile displayed successfully",
            "content":{
              "application/json":{
                "schema":{
                  "$ref":"#/components/schemas/customer"
                }
              }
            }
          }
        }
      }
    },
    "/api/customer-info/addPayment": {
      "post": {
        "description": "Add customer's payment info",
        "operationId": "createPayment",
        "parameters":[
          {
            "name": "customer_id",
            "in":"query",
            "description":"customer's id",
            "required": true,
            "schema":{
              "type":"integer"
            }
          },

          {
            "name": "order_id",
            "in":"query",
            "description":"order's id",
            "required": true,
            "schema":{
              "type":"integer"
            }
          },

          {
            "name": "total_price",
            "in":"query",
            "description": "Final total price of the order (including shipping cost)",
            "required": true,
            "schema":{
              "type":"number",
              "format":"double"
            }
          },

          {
            "name": "last_4_digits",
            "in":"query",
            "description":"last 4 digits",
            "required": true,
            "schema":{
              "type":"string"
            }
          },

          {
            "name": "card_type",
            "in":"query",
            "description":"card type",
            "required": true,
            "schema":{
              "type":"string"
            }
          }
        ],
        "responses":{
          "200":{
            "description": "customer's payment info added successfully",
            "content":{
              "application/json":{
                "schema":{
                  "$ref":"#/components/schemas/payment"
                }
              }
            }
          }
        }
      }
    },
    "/api/customer-info/getPayment/{order_id}": {
      "get": {
        "description": "Retrieve card type and last 4 digits for a given order ID",
        "operationId": "getPayment",
        "parameters":[
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema":{
              "type":"integer"
            }
            
          }
        ],
        "responses":{
          "200":{
            "description": "customer's payment info retrieved successfully",
            "content":{
              "application/json":{
                "schema":{
                  "$ref":"#/components/schemas/payment"
                }
              }
            }
          },
          "404": {
            "description": "Order not found"
          }

        }
      }
    },
    "/api/customer-info/getAllOrders/{shopper_id}": {
      "get":{
        "description": "display all orders given the customer id",
        "operationId": "getAllOrders",
        "parameters": [
          {
            "name": "shopper_id",
            "in":"path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses":{
          "200":{
            "description": "all orders retrived successfully",
            "content":{
              "application/json":{
                "schema":{
                  "$ref":"#/components/schemas/customer"
                }
              }
            }
          }
        }
      }
    },
    "/api/customer-info/getOrder/{order_id}": {
      "get": {
        "description": "get an order of a customer given the order id",
        "operationId": "getOrder",
        "parameters": [
          {
            "name":"order_id",
            "in":"path",
            "required": true,
            "schema":{
              "type":"integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An order is retrieved successfully",
            "content" : {
              "application/json": {
                "schema": {
                  "$ref":"#/components/schemas/orderRecord"
                }
              }
            }
          }
        }
      }
    },
    "/api/customer-info/getAllOrderItems/{order_id}": {
      "get":{
        "description": "get all order items of a customer given the order id",
        "operationId": "getAllOrderItems",
        "parameters":[
          {
            "name":"order_id",
            "in":"path",
            "required": true,
            "schema":{
              "type":"integer"
            }
          }
        ],
         "responses": {
          "200": {
            "description": "All order items is retrieved successfully",
            "content" : {
              "application/json": {
                "schema": {
                  "$ref":"#/components/schemas/orderItem"
                }
              }
            }
          }
        }
      }
    },
    "/api/customer-info/createOrder": {
      "post": {
        "description": "Add the order record and all order items to the database",
        "operationId": "createOrderItems",
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "description": "customer's id",
            "required": true,
            "schema":{
              "type":"integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "properties": {
                  "product_id": {
                    "type":"integer"
                  },
                  "quantity": {
                    "type": "integer"
                  },
                  "unit_price": {
                    "type": "number",
                    "format": "double"
                  }
                },
                "required": [
                  "product_id",
                  "quantity",
                  "unit_price"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer's order and order items added sucessfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/customerProduct"
                }
              }
            }
          }
        }

      }
    }
  },
  "components": {
    "schemas": {
      "customer": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "integer"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          }
        }
      },

      "customerProduct": {
        "type":"object",
        "properties":{
          "customer_id":{
            "type":"integer"
          },
          "products": {
            "type":"object",
            "properties": {
               "product_id": {
                "type":"integer"
              },
              "unit_price": {
                "type": "number",
                "format":"double"
              },
              "quantity": {
                "type":"integer"
              }

            }
          }
        }

      },
      "payment": {
        "type":"object",
        "properties":{
           "customer_id": {
            "type":"integer"
          },
           "order_id": {
            "type":"integer"
          },
          "total_price": {
            "type":"number",
            "format":"double"
          },
          "last_4_digits": {
            "type":"string"
          },
          "card_type": {
            "type":"integer"
          }
        }
      }
    }
  }
}